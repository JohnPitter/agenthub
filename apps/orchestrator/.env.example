# Anthropic
ANTHROPIC_API_KEY=

# Server
ORCHESTRATOR_PORT=3001

# Encryption (32-byte hex string for AES-256-GCM)
ENCRYPTION_KEY=

# GitHub OAuth
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:5173/api/auth/github/callback
JWT_SECRET=

# OAuth Provider Credentials (optional — auto-discovered from GitHub repos if not set)
# OpenAI: client ID scraped from openai/codex repo
OPENAI_OAUTH_CLIENT_ID=
# Gemini: client ID + secret scraped from google-gemini/gemini-cli repo
GEMINI_OAUTH_CLIENT_ID=
GEMINI_OAUTH_CLIENT_SECRET=
