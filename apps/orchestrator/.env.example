# ===========================================
# AgentHub Environment Configuration
# ===========================================

# -------------------------------------------
# OpenRouter API (Optional — can be configured via Admin panel)
# -------------------------------------------
# Get your API key from: https://openrouter.ai/keys
# OPENROUTER_API_KEY=sk-or-...

# -------------------------------------------
# Server Configuration
# -------------------------------------------
# Port for the orchestrator API server
ORCHESTRATOR_PORT=3001

# Node environment (development | production)
NODE_ENV=development

# -------------------------------------------
# Database (LuxView Cloud PostgreSQL)
# -------------------------------------------
# PostgreSQL connection - automatically injected by LuxView Cloud
# DATABASE_URL will be provided at runtime
# PGHOST, PGPORT, PGDATABASE, PGUSER, PGPASSWORD also available

# -------------------------------------------
# Security
# -------------------------------------------
# Encryption key for credentials (32 bytes hex, generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
# IMPORTANT: Generate a new key for production!
ENCRYPTION_KEY=

# -------------------------------------------
# Integrations (Optional)
# -------------------------------------------
# Telegram Bot Token
# Get from: https://t.me/BotFather
TELEGRAM_BOT_TOKEN=

# WhatsApp (uses whatsapp-web.js - no token needed)
# Sessions are stored in .wwebjs_auth/ directory

# -------------------------------------------
# Development
# -------------------------------------------
# Enable debug logging
DEBUG=false

# Log level (error | warn | info | debug)
LOG_LEVEL=info
