{
  "name": "agenthub",
  "private": true,
  "scripts": {
    "dev": "turbo dev",
    "dev:web": "turbo dev --filter=@agenthub/web",
    "dev:orchestrator": "turbo dev --filter=@agenthub/orchestrator",
    "build": "turbo build",
    "lint": "turbo lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "db:migrate": "node packages/database/dist/migrate.js",
    "db:seed": "node packages/database/dist/seed.js",
    "audit:check": "pnpm audit --audit-level moderate",
    "audit:fix": "pnpm audit --fix"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.1.2",
    "turbo": "^2.8.21",
    "typescript": "^6.0.2",
    "vitest": "^4.1.2"
  },
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "pnpm": {
    "overrides": {
      "drizzle-orm": "^0.39.0"
    }
  }
}
