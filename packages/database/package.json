{
  "name": "@agenthub/database",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./schema": {
      "import": "./dist/schema/index.js",
      "types": "./dist/schema/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsup",
    "migrate": "tsx src/migrate.ts",
    "seed": "tsx src/seed.ts",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@agenthub/shared": "workspace:*",
    "drizzle-orm": "^0.39.0",
    "postgres": "^3.4.4",
    "nanoid": "^5.1.0"
  },
  "devDependencies": {
    "@types/node": "^25.5.2",
    "drizzle-kit": "^0.31.10",
    "tsup": "^8.0.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2"
  }
}